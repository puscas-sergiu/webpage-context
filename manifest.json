{
  "manifest_version": 3,
  "name": "Webpage Summarizer & Chat",
  "short_name": "Page Chat",
  "version": "2.3.0",
  "description": "Summarize and chat with any page or YouTube video, then save it to a private, searchable knowledge base. Bring your own key.",
  "homepage_url": "https://github.com/puscas-sergiu/webpage-context",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://api.openai.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Summarize or chat with this page",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open Webpage Summarizer & Chat"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
